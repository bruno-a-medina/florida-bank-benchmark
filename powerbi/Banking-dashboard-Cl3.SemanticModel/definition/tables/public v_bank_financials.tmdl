table 'public v_bank_financials'
	lineageTag: aed4664c-6673-42bf-8a6b-7a02fed5168d

	measure 'Total Assets (Billions)' = SUM('public v_bank_financials'[total_assets]) / 1000000
		formatString: 0.0"B"
		lineageTag: 969d273c-b5e9-48d0-97f2-974f23f32905

	measure 'ROA %' = AVERAGE('public v_bank_financials'[return_on_assets]) / 100
		formatString: 0.00%
		lineageTag: d789e37a-8540-49cf-b30d-374ddaa87596

	measure 'ROA YoY Change %' = AVERAGE('public v_bank_financials'[roa_yoy]) / 100
		formatString: +0.00%;-0.00%;0.00%
		lineageTag: 6b5b5c48-2924-49d3-ad40-8516eda1f8f8

	measure 'ROA vs Peer Median %' = AVERAGE('public v_bank_financials'[roa_vs_peer]) / 100
		formatString: +0.00%;-0.00%;0.00%
		lineageTag: 7aeeac47-b499-43c8-859e-6148e749bc31

	measure 'Net Interest Margin %' = AVERAGE('public v_bank_financials'[net_interest_margin]) / 100
		formatString: 0.00%
		lineageTag: 49f76faf-5b3c-44e4-a058-9679ddb4b4ef

	measure 'Efficiency Ratio %' = AVERAGE('public v_bank_financials'[efficiency_ratio]) / 100
		formatString: 0.0%
		lineageTag: 800ae694-275f-4c11-b30d-c4bf8d17f526

	measure 'Noncurrent Loan Rate %' = AVERAGE('public v_bank_financials'[noncurrent_loan_rate]) / 100
		formatString: 0.00%
		lineageTag: cd2b7230-8587-4df1-a1d6-c28eb72db3ab

	measure 'Net Charge-Off Rate %' = AVERAGE('public v_bank_financials'[net_charge_off_rate]) / 100
		formatString: 0.00%
		lineageTag: 7a399e02-79e9-479f-8ac6-fe3e2dd4b68e

	measure 'Provision Rate %' = AVERAGE('public v_bank_financials'[provision_rate]) / 100
		formatString: 0.00%
		lineageTag: cc40b22c-9181-4e5c-9ec9-4be7e17b0c8f

	measure 'CET1 Capital Ratio %' = AVERAGE('public v_bank_financials'[cet1_capital_ratio]) / 100
		formatString: 0.0%
		lineageTag: dae44a8d-d60f-4391-aca3-0833bfbcd389

	measure 'Peer Median ROA %' = AVERAGE('public v_bank_financials'[peer_median_roa]) / 100
		formatString: 0.00%
		lineageTag: 1561f531-3654-43e3-bdfb-976462143a99

	measure 'Peer Median Noncurrent %' = AVERAGE('public v_bank_financials'[peer_median_noncurrent]) / 100
		formatString: 0.00%
		lineageTag: bfb1a80a-68d7-4359-8fa5-a4bc6c649433

	measure 'Period Label' =
			
			VAR d = MAX('public v_bank_financials'[date])
			RETURN "Q" & ROUNDUP(MONTH(d) / 3, 0) & " " & YEAR(d)
		lineageTag: 853bc30a-040a-4359-ab36-f600e7507c08

	measure 'ROA Title' = "ROA by Bank, " & [Period Label]
		lineageTag: 793c6d7a-ffe7-4f72-821f-97d136732c5d

	measure 'CET1 Title' = "CET1 Capital Ratio by Bank, " & [Period Label]
		lineageTag: 74e2dafd-1d33-42b0-9f25-688a93c87f35

	measure 'Noncurrent Title' = "Noncurrent Loan Rate, " & [Period Label]
		lineageTag: c61b1f20-09a9-4aaf-b200-1cf75799abd7

	measure 'YoY Title' = "ROA Change vs. Prior Year, " & [Period Label]
		lineageTag: 43edc0c6-9414-4437-bc6d-18b626daf5d2

	measure 'Assets Title' = "Share of Peer Group Assets ($B), " & [Period Label]
		lineageTag: c84d979a-519d-4742-aa69-ff5ee450f2af

